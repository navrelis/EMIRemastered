{
  "schemaVersion": 1,
  "id": "emi",
  "version": "${version}",
  "name": "EMI Remastered",
  "description": "EMI 1.1.24 and seven EMI add-ons (Loot, Ores, Effects, Enchanting, Professions, Let's Do, Distraction Free) merged into one Fabric 1.21.1 mod, plus pages that show where things come from.",
  "authors": [
    "Emi",
    "navrelis"
  ],
  "contributors": [
    "fzzyhmstrs",
    "Abbie",
    "Prismwork/Flamarine",
    "Mrbysco",
    "ShyNieke",
    "Pandaismyname1",
    "Toni (txnimc)",
    "unilock",
    "lxly9"
  ],
  "contact": {
    "homepage": "https://github.com/navrelis/EMIRemastered",
    "sources": "https://github.com/navrelis/EMIRemastered",
    "issues": "https://github.com/navrelis/EMIRemastered/issues"
  },
  "license": [
    "MIT",
    "LGPL-3.0-only"
  ],
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.emi.emi.platform.fabric.EmiMainFabric",
      "dev.emi.remastered.EmiRemasteredMain"
    ],
    "client": [
      "dev.emi.emi.platform.fabric.EmiClientFabric",
      "dev.emi.remastered.EmiRemasteredClient"
    ],
    "server": [],
    "emi": [
      "dev.emi.emi.VanillaPlugin",
      "dev.emi.remastered.loot.LootEmiPlugin",
      "dev.emi.remastered.ores.OresEmiPlugin",
      "dev.emi.remastered.effects.EffectsEmiPlugin",
      "dev.emi.remastered.enchanting.EnchantingEmiPlugin",
      "dev.emi.remastered.professions.ProfessionsEmiPlugin",
      "dev.emi.remastered.letsdo.LetsDoEmiPlugin",
      "dev.emi.remastered.mobs.MobsEmiPlugin",
      "dev.emi.remastered.stats.StatsEmiPlugin",
      "dev.emi.remastered.world.WorldEmiPlugin"
    ],
    "modmenu": [
      "dev.emi.emi.compat.EmiModMenu"
    ],
    "jei_mod_plugin": [
      "dev.emi.emi.jemi.JemiPlugin"
    ]
  },
  "custom": {
    "polymer:disable_mixin": {
      "polymer-core:client.compat.emi_ItemEmiStackMixin": "Please stop mixing into impl"
    }
  },
  "mixins": [
    "emi.mixins.json",
    "emi-fabric.mixins.json",
    "emi_remastered_loot.mixins.json",
    "emi_remastered_ores.mixins.json",
    "emi_remastered_effects.mixins.json",
    "emi_remastered_enchanting.mixins.json",
    "emi_remastered_professions.mixins.json",
    "emi_remastered_letsdo.mixins.json",
    "emi_remastered_distraction_free.mixins.json",
    "emi_remastered_info.mixins.json",
    "emi_remastered_mobs.mixins.json",
    "emi_remastered_tools.mixins.json",
    "emi_remastered_stats.mixins.json",
    "emi_remastered_world.mixins.json"
  ],
  "accessWidener": "emi.accesswidener",
  "provides": [
    "emi_loot",
    "emi_enchanting",
    "emiffect",
    "emiprofessions",
    "emi_ores",
    "emi_letsdo_compat",
    "distraction_free_recipes"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.1",
    "fabric-api": "*",
    "java": ">=21"
  }
}
