{
  "description": "Tools module: tag browser (list, tag selected, search, stale selection, member search, registry filter, long id tooltip, biome registry, reverse lookup, recipes/uses and back), EMI regex tag search and copy recipe (crafting shaped and shapeless, tag ingredients, smelting; text and JSON, feedback notice, module off).",
  "warmupTicks": 60,
  "settleTicks": 12,
  "stepTimeoutSeconds": 30,
  "worldJoinTimeoutSeconds": 120,
  "timeoutSeconds": 400,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },

    { "type": "open_inventory" },
    { "type": "key", "key": "T" },
    { "type": "note", "text": "T pressed in the inventory (open bind, real key path)" },
    { "type": "screenshot", "name": "tag-browser-list" },
    { "type": "close_screen" },
    { "type": "open_inventory" },

    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "openLogs" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "hoverFirstMember" },
    { "type": "wait", "ticks": 4 },
    { "type": "screenshot", "name": "tag-logs-selected-hover" },

    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "searchAxe" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "selection" },
    { "type": "note", "text": "logs does not match 'axe', so the right pane must not keep it (T1-9)" },
    { "type": "screenshot", "name": "search-axe" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "registryAll" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "searchClear" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "selectLogs" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "searchHusk" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "selection" },
    { "type": "note", "text": "@husk with the logs tag selected before: no stale selection, no stale hover (T1-9)" },
    { "type": "screenshot", "name": "search-member-husk" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "searchClear" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "registryEntities" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "registry-entity-types" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "hoverLongestTag" },
    { "type": "wait", "ticks": 4 },
    { "type": "note", "text": "long entity tag id: kept whole in the row, tooltip with title, full id, registry, count (T1-10)" },
    { "type": "screenshot", "name": "entity-long-tag-tooltip" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "registryBiomes" },
    { "type": "screenshot", "name": "registry-biomes" },

    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "closeScreen" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "openForOakLog" },
    { "type": "screenshot", "name": "reverse-lookup-oak-log" },

    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "clickFirstMember" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "click-member-recipes" },
    { "type": "key", "key": "ESCAPE" },
    { "type": "note", "text": "escape from the EMI recipes returns to the tag browser (the first member has loot recipes now, so the browser is left for the recipe screen)" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "back-in-browser-after-recipes" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "clickFirstMemberUses" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "click-member-uses" },
    { "type": "key", "key": "ESCAPE" },
    { "type": "note", "text": "escape from the EMI uses returns to the tag browser" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "back-in-browser" },
    { "type": "key", "key": "ESCAPE" },
    { "type": "note", "text": "escape from the browser returns to the inventory" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "back-in-inventory" },

    { "type": "emi_search", "text": "#/pickax/" },
    { "type": "wait", "ticks": 20 },
    { "type": "note", "text": "KB44: the regex tag search in the main EMI search field must list the pickaxe tag members" },
    { "type": "screenshot", "name": "emi-search-regex-pickaxe" },
    { "type": "emi_search", "text": "#pickax" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "emi-search-plain-pickaxe" },
    { "type": "emi_search", "text": "#/mineable/" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "emi-search-regex-mineable" },
    { "type": "emi_search", "text": "" },

    { "type": "emi_recipes", "item": "minecraft:iron_pickaxe" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyDefaultFirst" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyOtherFirst" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyDefault" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyOther" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "wait", "ticks": 14 },
    { "type": "note", "text": "the notice replaces the toast, which EMI hides on its screens (T1-6)" },
    { "type": "screenshot", "name": "copy-crafting-toast" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyModuleOff" },

    { "type": "emi_recipes", "item": "minecraft:flint_and_steel" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyDefault" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyOther" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "wait", "ticks": 14 },
    { "type": "screenshot", "name": "copy-shapeless" },

    { "type": "emi_recipes", "item": "minecraft:crafting_table" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyOther" },

    { "type": "emi_recipes", "item": "minecraft:iron_ingot" },
    { "type": "emi_category", "id": "minecraft:smelting" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyDefault" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyOther" },

    { "type": "close_screen" }
  ]
}
