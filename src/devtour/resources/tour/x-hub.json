    { "type": "open_emi_config" },
    { "type": "click_row", "text": "Tab Bar" },
    { "type": "screen_close" },
    { "type": "close_screen" },
    { "type": "set_gui_scale", "n": 1 },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:iron_ingot", "key": "R" },
