{
  "description": "Mobs module (FX-WD: one unit - points - on the page and in the Item Info, fitted portraits): mob pages (reached through the spawn egg of the mob), the spawn egg list in the index, and the mob section of the Item Info screen of a spawn egg.",
  "warmupTicks": 60,
  "settleTicks": 20,
  "stepTimeoutSeconds": 30,
  "worldJoinTimeoutSeconds": 120,
  "timeoutSeconds": 300,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "open_inventory" },

    { "type": "emi_recipes", "item": "minecraft:zombie_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "zombie" },
    { "type": "hover", "x": 250, "y": 147 },
    { "type": "screenshot", "name": "zombie-damage-tooltip" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "close_screen" },

    { "type": "emi_recipes", "item": "minecraft:wither_skeleton_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "wither-skeleton" },
    { "type": "close_screen" },

    { "type": "emi_recipes", "item": "minecraft:bat_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "bat" },
    { "type": "close_screen" },

    { "type": "note", "text": "FX-WD: portraits fit the box whatever the model size (silverfish and bee tiny, ghast huge)" },
    { "type": "emi_recipes", "item": "minecraft:silverfish_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "silverfish" },
    { "type": "close_screen" },
    { "type": "emi_recipes", "item": "minecraft:bee_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "bee" },
    { "type": "close_screen" },
    { "type": "emi_recipes", "item": "minecraft:ghast_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "ghast" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_search", "text": "spawn egg" },
    { "type": "screenshot", "name": "spawn-egg-list" },

    { "type": "emi_stack_key", "item": "minecraft:zombie_spawn_egg", "key": "I" },
    { "type": "screenshot", "name": "zombie-egg-item-info" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:wither_skeleton_spawn_egg", "key": "I" },
    { "type": "screenshot", "name": "wither-skeleton-egg-item-info" },
    { "type": "close_screen" },

    { "type": "open_emi_config" },
    { "type": "screenshot", "name": "config" }
  ]
}
