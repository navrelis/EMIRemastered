{
  "description": "LOOT-ASYNC: the structure lookup is delayed by 20 s (dev-only emi.devtour.lookupDelayMs), so the player joins before it is done. First the desert pyramid chest page has no 'Found in', the dune template Item Info no 'Chests in Structures' and the desert pyramid structure page no loot links; after the delay all three show them without an EMI reload. The same after a /reload (the lookup is built again, again delayed).",
  "systemProperties": { "emi.devtour.lookupDelayMs": "20000" },
  "warmupTicks": 20,
  "settleTicks": 20,
  "stepTimeoutSeconds": 40,
  "worldJoinTimeoutSeconds": 120,
  "timeoutSeconds": 300,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "emi_wait_loaded" },
    { "type": "open_inventory" },

    { "type": "note", "text": "Before the lookup is done: no 'Found in', no 'Chests in Structures', no loot links" },
    { "type": "emi_recipes", "item": "minecraft:dune_armor_trim_smithing_template" },
    { "type": "emi_category", "id": "emi_loot:chest_loot" },
    { "type": "screenshot", "name": "chest-before" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:dune_armor_trim_smithing_template", "key": "I" },
    { "type": "screenshot", "name": "item-info-before" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "desertPyramid" },
    { "type": "screenshot", "name": "structure-before" },
    { "type": "close_screen" },

    { "type": "note", "text": "Waiting for the delayed lookup (no EMI reload expected)" },
    { "type": "wait", "ticks": 500 },

    { "type": "open_inventory" },
    { "type": "emi_recipes", "item": "minecraft:dune_armor_trim_smithing_template" },
    { "type": "emi_category", "id": "emi_loot:chest_loot" },
    { "type": "screenshot", "name": "chest-after" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:dune_armor_trim_smithing_template", "key": "I" },
    { "type": "screenshot", "name": "item-info-after" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "desertPyramid" },
    { "type": "screenshot", "name": "structure-after" },
    { "type": "close_screen" },

    { "type": "note", "text": "/reload: the lookup is built again (delayed again)" },
    { "type": "command", "text": "/reload", "waitTicks": 60 },
    { "type": "emi_wait_loaded" },
    { "type": "open_inventory" },
    { "type": "emi_recipes", "item": "minecraft:dune_armor_trim_smithing_template" },
    { "type": "emi_category", "id": "emi_loot:chest_loot" },
    { "type": "screenshot", "name": "chest-after-reload-before-lookup" },
    { "type": "close_screen" },
    { "type": "wait", "ticks": 500 },
    { "type": "open_inventory" },
    { "type": "emi_recipes", "item": "minecraft:dune_armor_trim_smithing_template" },
    { "type": "emi_category", "id": "emi_loot:chest_loot" },
    { "type": "screenshot", "name": "chest-after-reload-after-lookup" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "desertPyramid" },
    { "type": "screenshot", "name": "structure-after-reload-after-lookup" },
    { "type": "close_screen" }
  ]
}
