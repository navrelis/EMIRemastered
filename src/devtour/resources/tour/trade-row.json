{
  "description": "TRADE-ROW: Item Info trade rows. The amount of the viewed item is in the row title, the stacks on the right carry their own amounts: nether wart (bought by the cleric), bread (sold by the farmer), paper (bought, librarian), emerald (currency, grouped rows).",
  "warmupTicks": 60,
  "settleTicks": 10,
  "stepTimeoutSeconds": 30,
  "worldJoinTimeoutSeconds": 180,
  "timeoutSeconds": 300,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "emi_wait_loaded" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:nether_wart", "key": "I" },
    { "type": "screenshot", "name": "info-nether-wart" },
    { "type": "hover", "x": 200, "y": 308 },
    { "type": "wait", "ticks": 6 },
    { "type": "screenshot", "name": "info-nether-wart-row-tooltip" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-nether-wart-scroll" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:bread", "key": "I" },
    { "type": "screenshot", "name": "info-bread" },
    { "type": "hover", "x": 200, "y": 268 },
    { "type": "wait", "ticks": 6 },
    { "type": "screenshot", "name": "info-bread-row-tooltip" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-bread-scroll" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:paper", "key": "I" },
    { "type": "screenshot", "name": "info-paper" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-paper-scroll" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:iron_chestplate", "key": "I" },
    { "type": "screenshot", "name": "info-iron-chestplate" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-iron-chestplate-scroll" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:bookshelf", "key": "I" },
    { "type": "screenshot", "name": "info-bookshelf" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-bookshelf-scroll" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:emerald", "key": "I" },
    { "type": "screenshot", "name": "info-emerald" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-emerald-scroll" },
    { "type": "close_screen" }
  ]
}
