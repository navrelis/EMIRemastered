{
  "description": "Stats module: the Food category (shanks, saturation, effects, converts-to item) and the Food/Tool/Weapon/Armour sections of the Item Info page.",
  "warmupTicks": 60,
  "settleTicks": 10,
  "stepTimeoutSeconds": 30,
  "worldJoinTimeoutSeconds": 120,
  "timeoutSeconds": 420,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "emi_wait_loaded" },

    { "type": "emi_uses", "item": "minecraft:golden_apple" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-golden-apple" },
    { "type": "emi_uses", "item": "minecraft:cooked_beef" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-cooked-beef" },
    { "type": "emi_uses", "item": "minecraft:honey_bottle" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-honey-bottle-converts" },
    { "type": "emi_uses", "item": "minecraft:enchanted_golden_apple" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-enchanted-golden-apple-four-effects" },
    { "type": "emi_uses", "item": "minecraft:beetroot_soup" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-bowl-converts" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:diamond_sword", "key": "I" },
    { "type": "screenshot", "name": "info-diamond-sword" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-diamond-sword-details" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:diamond_pickaxe", "key": "I" },
    { "type": "screenshot", "name": "info-diamond-pickaxe" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-diamond-pickaxe-details" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:iron_chestplate", "key": "I" },
    { "type": "screenshot", "name": "info-iron-chestplate" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-iron-chestplate-details" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:netherite_chestplate", "key": "I" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-netherite-chestplate-toughness-knockback" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:golden_apple", "key": "I" },
    { "type": "screenshot", "name": "info-golden-apple" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-golden-apple-details" },
    { "type": "close_screen" }
  ]
