    { "type": "command", "text": "/give @p minecraft:stick 1", "waitTicks": 40 },
    { "type": "call", "class": "dev.emi.remastered.devtour.Kb7Tour", "method": "report" },
    { "type": "screenshot", "name": "one-stick-stick-tooltip" },
    { "type": "hover", "x": 300, "y": 300 },
    { "type": "screenshot", "name": "one-stick" },
    { "type": "command", "text": "/give @p minecraft:stick 2", "waitTicks": 40 },
    { "type": "call", "class": "dev.emi.remastered.devtour.Kb7Tour", "method": "report" },
    { "type": "screenshot", "name": "three-sticks" }
