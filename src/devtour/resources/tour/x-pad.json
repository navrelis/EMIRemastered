{
  "description": "X-PAD: right-aligned texts of Item Info rows (counts, percentages, bar values) keep a gap to the edge of the scroll area: golden apple, diamond (loot chances), nether wart / bread (trade counts).",
  "warmupTicks": 60,
  "settleTicks": 10,
  "stepTimeoutSeconds": 30,
  "worldJoinTimeoutSeconds": 180,
  "timeoutSeconds": 300,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "emi_wait_loaded" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:golden_apple", "key": "I" },
    { "type": "screenshot", "name": "info-golden-apple" },
    { "type": "screen_scroll", "amount": -3 },
    { "type": "screenshot", "name": "info-golden-apple-scroll1" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-golden-apple-scroll-end" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:diamond", "key": "I" },
    { "type": "screenshot", "name": "info-diamond" },
    { "type": "screen_scroll", "amount": -3 },
    { "type": "screenshot", "name": "info-diamond-scroll1" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-diamond-scroll-end" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:nether_wart", "key": "I" },
    { "type": "screenshot", "name": "info-nether-wart" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-nether-wart-scroll" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:bread", "key": "I" },
    { "type": "screenshot", "name": "info-bread" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-bread-scroll" },
    { "type": "close_screen" }
  ]
}
