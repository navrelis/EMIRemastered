{
  "description": "Item Info advancements section: crafting table, iron ingot and diamond without progress (the client only knows the visible advancements), then after '/advancement grant @a everything' (Details > Advancements, click opens the advancement screen); the progress is revoked again at the end.",
  "warmupTicks": 60,
  "settleTicks": 20,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "open_inventory" },
    { "type": "note", "text": "before the grant: only the advancements the server already shows the new player are known" },
    { "type": "emi_stack_key", "item": "minecraft:crafting_table", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "before-crafting-table-info" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "before-crafting-table-info-end" },
    { "type": "close_screen" },
    { "type": "emi_stack_key", "item": "minecraft:iron_ingot", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "before-iron-ingot-info" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "before-iron-ingot-info-end" },
    { "type": "close_screen" },
    { "type": "emi_stack_key", "item": "minecraft:diamond", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "before-diamond-info" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "before-diamond-info-end" },
    { "type": "close_screen" },
    { "type": "command", "text": "/gamerule announceAdvancements false", "waitTicks": 5 },
    { "type": "command", "text": "/advancement grant @a everything", "waitTicks": 40 },
    { "type": "wait", "ticks": 40 },
    { "type": "open_inventory" },
    { "type": "note", "text": "after the grant the client knows all advancements; hidden ones show because they are done" },
    { "type": "emi_stack_key", "item": "minecraft:crafting_table", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "after-crafting-table-info" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "after-crafting-table-info-end" },
    { "type": "close_screen" },
    { "type": "emi_stack_key", "item": "minecraft:iron_ingot", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "after-iron-ingot-info" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "after-iron-ingot-info-end" },
    { "type": "close_screen" },
    { "type": "emi_stack_key", "item": "minecraft:diamond", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screenshot", "name": "after-diamond-info" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "after-diamond-info-end" },
    { "type": "close_screen" },
    { "type": "emi_stack_key", "item": "minecraft:diamond", "key": "I" },
    { "type": "wait", "ticks": 20 },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screen_info" },
    { "type": "close_screen" },
    { "type": "command", "text": "/advancement revoke @a everything", "waitTicks": 20 },
    { "type": "command", "text": "/gamerule announceAdvancements true", "waitTicks": 5 }
  ]
}
