{
  "description": "THEME: one screenshot per kind of EMI page for the resource-pack text colour remap (text_colors.json, docs/THEMING.md): run once without and once with the Mandala's GUI x Nytheria pack and compare. Item Info (golden apple, nether wart, tools, armour), crafting recipe, mob, food, enchantment, effect, ore generation, chest and mob loot, trades, structure, biome, tag browser, copy notice.",
  "warmupTicks": 60,
  "settleTicks": 12,
  "stepTimeoutSeconds": 30,
  "worldJoinTimeoutSeconds": 180,
  "timeoutSeconds": 600,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "emi_wait_loaded" },
    { "type": "command", "text": "/time set day", "waitTicks": 3 },

    { "type": "open_inventory" },
    { "type": "emi_search", "text": "golden" },
    { "type": "screenshot", "name": "index-search-golden" },
    { "type": "emi_search", "text": "" },

    { "type": "emi_stack_key", "item": "minecraft:golden_apple", "key": "I" },
    { "type": "screenshot", "name": "info-golden-apple" },
    { "type": "screen_scroll", "amount": -8 },
    { "type": "screenshot", "name": "info-golden-apple-mid" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-golden-apple-end" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:nether_wart", "key": "I" },
    { "type": "screenshot", "name": "info-nether-wart" },
    { "type": "screen_scroll", "amount": -8 },
    { "type": "screenshot", "name": "info-nether-wart-mid" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-nether-wart-end" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:diamond_sword", "key": "I" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-diamond-sword-tool-stats" },
    { "type": "screen_scroll", "amount": -100 },
    { "type": "screenshot", "name": "info-diamond-sword-end" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:netherite_chestplate", "key": "I" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "info-netherite-chestplate-armour-stats" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_stack_key", "item": "minecraft:wheat", "key": "I" },
    { "type": "screen_scroll", "amount": -30 },
    { "type": "hover", "x": 320, "y": 175 },
    { "type": "wait", "ticks": 6 },
    { "type": "screenshot", "name": "info-wheat-trade-row-hover" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "emi_recipes", "item": "minecraft:iron_pickaxe" },
    { "type": "emi_category", "id": "minecraft:crafting" },
    { "type": "screenshot", "name": "recipe-crafting-iron-pickaxe" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "copyDefaultFirst" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "wait", "ticks": 14 },
    { "type": "screenshot", "name": "recipe-copy-notice" },
    { "type": "emi_category", "id": "emiprofessions:villager_trades" },
    { "type": "screenshot", "name": "trades-iron-pickaxe" },
    { "type": "close_screen" },

    { "type": "emi_recipes", "item": "minecraft:zombie_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "mob-zombie" },
    { "type": "hover", "x": 250, "y": 147 },
    { "type": "screenshot", "name": "mob-zombie-damage-tooltip" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "close_screen" },

    { "type": "emi_recipes", "item": "minecraft:wither_skeleton_spawn_egg" },
    { "type": "emi_category", "id": "emi_mobs:mob_info" },
    { "type": "screenshot", "name": "mob-wither-skeleton" },
    { "type": "close_screen" },

    { "type": "emi_uses", "item": "minecraft:golden_apple" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-golden-apple" },
    { "type": "close_screen" },
    { "type": "emi_uses", "item": "minecraft:enchanted_golden_apple" },
    { "type": "emi_category", "id": "emi_stats:food" },
    { "type": "screenshot", "name": "food-enchanted-golden-apple" },
    { "type": "close_screen" },

    { "type": "emi_uses", "item": "minecraft:diamond_sword" },
    { "type": "emi_category", "id": "emi_enchanting:enchantments" },
    { "type": "screenshot", "name": "enchant-sword-first" },
    { "type": "emi_recipe_tab", "index": 4, "page": 5 },
    { "type": "screenshot", "name": "enchant-sharpness" },
    { "type": "emi_recipe_tab", "index": 4, "page": 7 },
    { "type": "screenshot", "name": "enchant-mending" },
    { "type": "close_screen" },

    { "type": "emi_recipes", "effect": "minecraft:speed" },
    { "type": "screenshot", "name": "effect-speed" },
    { "type": "click", "x": 383, "y": 270 },
    { "type": "screenshot", "name": "effect-speed-page2" },
    { "type": "emi_recipes", "effect": "minecraft:poison" },
    { "type": "screenshot", "name": "effect-poison" },
    { "type": "close_screen" },

    { "type": "emi_recipes", "item": "minecraft:diamond_ore" },
    { "type": "emi_category", "id": "emi_ores:oregen" },
    { "type": "screenshot", "name": "oregen-diamond" },
    { "type": "hover", "x": 390, "y": 98 },
    { "type": "screenshot", "name": "oregen-diamond-barrier-tooltip" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "close_screen" },

    { "type": "emi_recipes", "item": "minecraft:dune_armor_trim_smithing_template" },
    { "type": "emi_category", "id": "emi_loot:chest_loot" },
    { "type": "screenshot", "name": "loot-chest-desert-pyramid" },
    { "type": "close_screen" },
    { "type": "emi_recipes", "item": "minecraft:nether_wart" },
    { "type": "emi_category", "id": "emi_loot:chest_loot" },
    { "type": "screenshot", "name": "loot-chest-nether-wart" },
    { "type": "close_screen" },
    { "type": "emi_recipes", "item": "minecraft:rotten_flesh" },
    { "type": "emi_category", "id": "emi_loot:mob_drops" },
    { "type": "screenshot", "name": "loot-mob-rotten-flesh" },
    { "type": "close_screen" },
    { "type": "emi_recipes", "item": "minecraft:diamond" },
    { "type": "emi_category", "id": "emi_loot:block_drops" },
    { "type": "screenshot", "name": "loot-block-diamond" },
    { "type": "close_screen" },

    { "type": "emi_uses", "item": "minecraft:emerald" },
    { "type": "emi_category", "id": "emiprofessions:villager_trades" },
    { "type": "screenshot", "name": "trades-emerald-uses" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "villagePlains" },
    { "type": "screenshot", "name": "world-structure-village" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "stronghold" },
    { "type": "screenshot", "name": "world-structure-stronghold" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "trialChambers" },
    { "type": "screenshot", "name": "world-structure-trial-chambers" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "plains" },
    { "type": "screenshot", "name": "world-biome-plains" },
    { "type": "call", "class": "dev.emi.remastered.devtour.WorldTour", "method": "netherWastes" },
    { "type": "screenshot", "name": "world-biome-nether-wastes" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "key", "key": "T" },
    { "type": "screenshot", "name": "tags-list" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "openLogs" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "hoverFirstMember" },
    { "type": "wait", "ticks": 4 },
    { "type": "screenshot", "name": "tags-logs-selected-hover" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "registryBiomes" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "tags-biomes-selected" },
    { "type": "call", "class": "dev.emi.remastered.devtour.ToolsTour", "method": "closeScreen" },
    { "type": "close_screen" },

    { "type": "open_emi_config" },
    { "type": "screenshot", "name": "emi-config" },
    { "type": "close_screen" }
  ]
}
