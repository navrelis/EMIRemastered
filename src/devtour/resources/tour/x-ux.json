{
  "description": "X-UX: mobs without spawn egg are mob stacks in the index (search Iron Golem finds its egg, Ender Dragon the mob stack; R on the ender dragon opens its Mob Info page, U on the wither lists Mob Info and Mob Drops, Item Info of the stack); Ctrl+Y tab list has no empty Trial Chamber Loot tab (loot.split-chest-loot-by-trial is off); with ores.add-biomes-to-index off the world module still adds the biome stacks, each exactly once; Item Info of a biome and a structure stack has a Details section with their key facts.",
  "warmupTicks": 60,
  "settleTicks": 20,
  "stepTimeoutSeconds": 40,
  "worldJoinTimeoutSeconds": 120,
  "timeoutSeconds": 420,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "emi_wait_loaded" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "mobStacks" },

    { "type": "emi_search", "text": "Iron Golem" },
    { "type": "screenshot", "name": "index-search-iron-golem" },
    { "type": "emi_search", "text": "Ender Dragon" },
    { "type": "screenshot", "name": "index-search-ender-dragon" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "favoriteDragon" },
    { "type": "screenshot", "name": "dragon-favourited" },
    { "type": "emi_search", "text": "Giant" },
    { "type": "screenshot", "name": "index-search-giant" },
    { "type": "emi_search", "text": "" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "rEnderDragon" },
    { "type": "screenshot", "name": "r-on-ender-dragon-mob-page" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "uWither" },
    { "type": "screenshot", "name": "u-on-wither" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "infoWither" },
    { "type": "screenshot", "name": "item-info-wither" },
    { "type": "close_screen" },

    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "allRecipes" },
    { "type": "screenshot", "name": "ctrl-y-tab-list-trial-split-off" },
    { "type": "close_screen" },

    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "oresBiomeIndexOff" },
    { "type": "emi_wait_loaded" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "biomeStacks" },
    { "type": "emi_search", "text": "Plains" },
    { "type": "screenshot", "name": "biome-stacks-with-ores-index-off" },
    { "type": "emi_search", "text": "" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "infoPlainsBiome" },
    { "type": "screenshot", "name": "item-info-biome-plains" },
    { "type": "screen_scroll", "amount": -10 },
    { "type": "screenshot", "name": "item-info-biome-plains-details" },
    { "type": "close_screen" },
    { "type": "open_inventory" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "infoVillage" },
    { "type": "screenshot", "name": "item-info-structure-village" },
    { "type": "close_screen" },

    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "oresBiomeIndexOn" },
    { "type": "emi_wait_loaded" },
    { "type": "call", "class": "dev.emi.remastered.devtour.XUxTour", "method": "biomeStacks" }
  ]
}
