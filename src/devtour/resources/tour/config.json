{
  "description": "EMI config screen with the module groups: module switches (toggled and restored), module setting groups, jump buttons and icons, Plugins button, small window, GUI scale 3, GUI scale 1 (all module jump icons).",
  "warmupTicks": 60,
  "settleTicks": 10,
  "steps": [
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 2 },
    { "type": "open_emi_config" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screenshot", "name": "config-top" },
    { "type": "screen_info" },

    { "type": "hover", "x": 10, "y": 250 },
    { "type": "screenshot", "name": "jump-hover-modules" },
    { "type": "hover", "x": 630, "y": 5 },

    { "type": "emi_config_jump", "group": "modules" },
    { "type": "screenshot", "name": "group-modules" },

    { "type": "click", "text": "Modules" },
    { "type": "screenshot", "name": "group-modules-click" },

    { "type": "note", "text": "per-module jump buttons are trimmed on small screens; a 1920x1080 window at GUI scale 2 has room for all of them" },
    { "type": "resize", "w": 1920, "h": 1080 },
    { "type": "wait", "ticks": 10 },
    { "type": "hover", "x": 1900, "y": 5 },
    { "type": "emi_config_jump", "group": "general" },
    { "type": "screenshot", "name": "scale-2-1080p-all-module-jumps" },
    { "type": "emi_config_jump", "group": "loot" },
    { "type": "screenshot", "name": "group-loot" },
    { "type": "emi_config_jump", "group": "ores" },
    { "type": "screenshot", "name": "group-ores" },
    { "type": "emi_config_jump", "group": "effects" },
    { "type": "screenshot", "name": "group-effects" },
    { "type": "emi_config_jump", "group": "enchanting" },
    { "type": "screenshot", "name": "group-enchanting" },
    { "type": "emi_config_jump", "group": "professions" },
    { "type": "screenshot", "name": "group-professions" },
    { "type": "emi_config_jump", "group": "distraction_free" },
    { "type": "screenshot", "name": "group-distraction-free" },
    { "type": "emi_config_jump", "group": "info" },
    { "type": "screenshot", "name": "group-info" },
    { "type": "emi_config_jump", "group": "mobs" },
    { "type": "screenshot", "name": "group-mobs" },
    { "type": "emi_config_jump", "group": "tools" },
    { "type": "screenshot", "name": "group-tools" },
    { "type": "emi_config_jump", "group": "stats" },
    { "type": "screenshot", "name": "group-stats" },
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "wait", "ticks": 10 },

    { "type": "scroll", "amount": -10, "x": 320, "y": 180 },
    { "type": "screenshot", "name": "scrolled-end" },
    { "type": "scroll", "amount": 3, "x": 320, "y": 180 },
    { "type": "screenshot", "name": "scrolled-back-3" },

    { "type": "click_row", "text": "Distraction-Free Recipes" },
    { "type": "screenshot", "name": "switch-distraction-free-off" },
    { "type": "click_row", "text": "Let's Do" },
    { "type": "screenshot", "name": "switch-letsdo-off" },
    { "type": "hover", "x": 480, "y": 150 },
    { "type": "screenshot", "name": "switch-tooltip" },
    { "type": "hover", "x": 630, "y": 5 },
    { "type": "screen_close" },
    { "type": "emi_wait_loaded" },

    { "type": "open_emi_config" },
    { "type": "emi_config_jump", "group": "modules" },
    { "type": "screenshot", "name": "reopened-after-switch-off" },
    { "type": "click_row", "text": "Distraction-Free Recipes" },
    { "type": "click_row", "text": "Let's Do" },
    { "type": "screenshot", "name": "switches-restored" },
    { "type": "screen_close" },
    { "type": "emi_wait_loaded" },

    { "type": "open_emi_config" },
    { "type": "emi_config_jump", "group": "general" },
    { "type": "click", "text": "Modules" },
    { "type": "screenshot", "name": "jump-modules-button" },

    { "type": "resize", "w": 854, "h": 480 },
    { "type": "wait", "ticks": 10 },
    { "type": "screenshot", "name": "small-window" },
    { "type": "emi_config_jump", "group": "general" },
    { "type": "screenshot", "name": "small-window-top" },

    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "set_gui_scale", "n": 3 },
    { "type": "wait", "ticks": 10 },
    { "type": "screenshot", "name": "scale-3" },
    { "type": "resize", "w": 2560, "h": 1440 },
    { "type": "wait", "ticks": 10 },
    { "type": "emi_config_jump", "group": "general" },
    { "type": "hover", "x": 2540, "y": 5 },
    { "type": "screenshot", "name": "scale-3-1440p-all-module-jumps" },
    { "type": "resize", "w": 1280, "h": 720 },
    { "type": "wait", "ticks": 10 },

    { "type": "set_gui_scale", "n": 1 },
    { "type": "wait", "ticks": 10 },
    { "type": "hover", "x": 1270, "y": 5 },
    { "type": "screenshot", "name": "scale-1-all-module-jumps" },
    { "type": "click", "text": "Effects" },
    { "type": "screenshot", "name": "scale-1-jump-effects" },

    { "type": "set_gui_scale", "n": 2 },
    { "type": "screen_close" }
  ]
}
